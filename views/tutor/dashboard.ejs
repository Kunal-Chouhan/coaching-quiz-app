<%- include('../partials/header') %>

<h2 class="mb-4">Tutor Dashboard</h2>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="stat-card">
      <h6>Total Quizzes</h6>
      <div class="stat-value"><%= totalQuizzes %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <h6>Published Quizzes</h6>
      <div class="stat-value"><%= publishedQuizzes %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <h6>Total Student Attempts</h6>
      <div class="stat-value"><%= totalAttempts %></div>
    </div>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Recent Quizzes</h4>
  <div>
    <a href="/tutor/quizzes/generate" class="btn btn-outline-primary me-2">Generate with AI</a>
    <a href="/tutor/quizzes/create" class="btn btn-primary">+ Create New Quiz</a>
  </div>
</div>

<% if (recentQuizzes.length === 0) { %>
  <p class="text-muted">No quizzes yet. Create your first quiz to get started.</p>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Title</th>
          <th>Questions</th>
          <th>Duration</th>
          <th>Status</th>
          <th>Test code</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% recentQuizzes.forEach(quiz => { %>
          <tr>
            <td><%= quiz.title %></td>
            <td><%= quiz.questions.length %></td>
            <td><%= quiz.duration %> min</td>
            <td>
              <span class="badge <%= quiz.isPublished ? 'bg-success' : 'bg-secondary' %>">
                <%= quiz.isPublished ? 'Published' : 'Draft' %>
              </span>
            </td>
            <td><span class="code-chip"><%= quiz.accessCode %></span></td>
            <td><a href="/tutor/quizzes/<%= quiz._id %>/results" class="btn btn-sm btn-outline-primary">View Results</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <a href="/tutor/quizzes" class="btn btn-link ps-0">View all quizzes →</a>
<% } %>

<%- include('../partials/footer') %>
