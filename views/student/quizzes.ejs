<%- include('../partials/header') %>

<h2 class="mb-4">Available Quizzes</h2>

<% if (quizzes.length === 0) { %>
  <div class="alert alert-light border">No quizzes are available right now. Please check back later.</div>
<% } else { %>
  <div class="row g-3">
    <% quizzes.forEach(quiz => { %>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= quiz.title %></h5>
            <p class="card-text text-muted flex-grow-1"><%= quiz.description %></p>
            <p class="small text-muted mb-3">
              📝 <%= quiz.questions.length %> questions &nbsp;|&nbsp; ⏱ <%= quiz.duration %> min
            </p>
            <a href="/quizzes/<%= quiz._id %>" class="btn btn-primary">Start Quiz</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
