<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm mb-4">
      <div class="card-body p-4 text-center">
        <h3>Result — <%= attempt.studentName %></h3>
        <h1 class="display-4 my-3"><%= attempt.score %>/<%= totalQuestions %></h1>
        <p class="fs-5">
          Percentage:
          <span class="badge <%= attempt.percentage >= 60 ? 'bg-success' : 'bg-danger' %> fs-6">
            <%= attempt.percentage %>%
          </span>
        </p>
        <div class="row mt-4">
          <div class="col-4">
            <div class="text-success fs-4">✔ <%= correctCount %></div>
            <div class="text-muted small">Correct</div>
          </div>
          <div class="col-4">
            <div class="text-danger fs-4">✘ <%= wrongCount %></div>
            <div class="text-muted small">Wrong</div>
          </div>
          <div class="col-4">
            <div class="fs-4">⏱ <%= timeTakenFormatted %></div>
            <div class="text-muted small">Time Taken</div>
          </div>
        </div>
      </div>
    </div>

    <h4 class="mb-3">Review Your Answers</h4>
    <% review.forEach((r, idx) => { %>
      <div class="card mb-2 <%= r.isCorrect ? 'border-success' : 'border-danger' %>">
        <div class="card-body">
          <h6>Q<%= idx + 1 %>. <%= r.questionText %></h6>
          <ul class="list-unstyled mb-0">
            <% r.options.forEach((opt, optIdx) => {
              let cls = '';
              if (optIdx === r.correctAnswerIndex) cls = 'text-success fw-semibold';
              if (optIdx === r.selectedOptionIndex && !r.isCorrect) cls = 'text-danger fw-semibold';
            %>
              <li class="<%= cls %>">
                <%= optIdx === r.correctAnswerIndex ? '✔' : (optIdx === r.selectedOptionIndex ? '✘' : '•') %>
                <%= opt %>
                <% if (optIdx === r.selectedOptionIndex) { %> <span class="badge bg-light text-dark border">Your answer</span><% } %>
              </li>
            <% }) %>
          </ul>
          <% if (r.selectedOptionIndex === null) { %>
            <div class="text-muted small mt-2">Not answered</div>
          <% } %>
        </div>
      </div>
    <% }) %>

    <a href="/quizzes" class="btn btn-primary mt-3">Enter another code</a>
  </div>
</div>

<%- include('../partials/footer') %>
