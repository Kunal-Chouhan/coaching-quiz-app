<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Coaching Quiz System' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/quizzes">आदर्श विद्यालय</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/quizzes">Enter a test code</a></li>
          <% if (typeof currentTutor !== 'undefined' && currentTutor) { %>
            <li class="nav-item"><a class="nav-link" href="/tutor/dashboard">Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/tutor/quizzes">My Quizzes</a></li>
            <li class="nav-item">
              <form action="/logout?_method=POST" method="POST" class="d-inline">
                <button type="submit" class="btn btn-outline-light btn-sm ms-2">Logout (<%= currentTutor.name %>)</button>
              </form>
            </li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/login">Tutor Login</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
  <div class="container pb-5">
